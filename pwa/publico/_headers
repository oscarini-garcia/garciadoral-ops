# Cabeceras de Cloudflare Pages.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups

# Descomente la política de contenido tras sustituir EJEMPLO por el subdominio
# real del Worker. Con `connect-src` mal puesto la aplicación deja de hablar con
# la API, así que conviene activarla y comprobar el acceso en el mismo paso.
#  Content-Security-Policy: default-src 'self'; script-src 'self' https://appleid.cdn-apple.com; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://agenda-familiar-api.EJEMPLO.workers.dev https://appleid.apple.com; frame-src https://appleid.apple.com; base-uri 'none'; form-action 'self'

# El armazón lo gestiona el service worker; estos dos deben poder cambiar sin
# esperar a que caduque ninguna caché intermedia.
/sw.js
  Cache-Control: no-cache

/config.json
  Cache-Control: no-cache
