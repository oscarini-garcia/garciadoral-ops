{
  "name": "agenda-familiar",
  "version": "1.24.0",
  "private": true,
  "type": "module",
  "description": "Agenda Familiar — aplicación web y cáscara iOS con actualizaciones OTA",
  "scripts": {
    "preparar": "python3 ../herramientas/preparar-pwa.py",
    "servir": "npx http-server publico -p 8788 -c-1",
    "sync:ios": "npm run preparar && cap sync ios && npm run patch:ios",
    "patch:ios": "node scripts/patch-ios.mjs",
    "open:ios": "cap open ios",
    "assets:ios": "npx @capacitor/assets generate --ios"
  },
  "dependencies": {
    "@capacitor-community/apple-sign-in": "^7.1.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/local-notifications": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "@capgo/capacitor-updater": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  }
}
